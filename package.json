{
  "name": "scwlkr-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit && node --check public/app.js && node --check scripts/verify-site.mjs",
    "test": "node scripts/verify-site.mjs && npm run test:e2e",
    "test:e2e": "playwright test",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "check": "npm run typecheck && node scripts/verify-site.mjs && npm run build && npm run test:e2e",
    "release:check": "npm run check",
    "deploy:preview": "npm run release:check && wrangler deploy --config wrangler.preview.jsonc",
    "deploy": "npm run release:check && wrangler deploy",
    "verify:public": "SITE_URL=https://scwlkr.com node scripts/verify-site.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2 || 2.3.3": true,
    "workerd@1.20260815.1": true
  }
}
