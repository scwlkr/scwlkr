{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Existing Worker name retained so the verified custom-domain route stays atomic.
  "name": "scwlkr-room",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/"]
  },
  "routes": [
    {
      "pattern": "scwlkr.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
