{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Existing Worker name retained so the verified custom-domain route stays atomic.
  "name": "scwlkr-room",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "scwlkr.com",
      "custom_domain": true
    }
  ],
  // The unbound class declaration preserves dormant legacy storage until its
  // irreversible deletion receives a separate, explicit approval.
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
