{
  "name": "scwlkr-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit && node --check public/app.js",
    "test": "vitest run --max-workers=1 --no-isolate",
    "test:e2e": "playwright test",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "load:test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "5.20260726.1",
    "@playwright/test": "1.62.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0",
    "ws": "8.21.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2 || 2.3.3": true,
    "workerd@1.20260722.1": true
  }
}
