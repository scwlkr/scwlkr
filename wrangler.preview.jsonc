{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scwlkr-room-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/"]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
